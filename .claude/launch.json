{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tutor-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "tools/run_dev_api.py", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "student-web",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run", "python", "-m", "http.server", "8081",
        "--bind", "127.0.0.1",
        "--directory", "apps/flutter_student/build/web"
      ],
      "port": 8081
    },
    {
      "name": "admin-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/admin_web", "run", "dev"],
      "port": 5174
    }
  ]
}
