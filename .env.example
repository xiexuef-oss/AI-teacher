# 复制为 .env 后按需填写。本文件不包含任何密钥，也不要把密钥提交进仓库。

# ---- API 服务 ----
# local / dev / staging / prod
TUTOR_ENV=local
# 开发态默认用 SQLite 文件保存演示状态；接入 MySQL 时改为 mysql+pymysql://...
TUTOR_DATABASE_URL=sqlite:///var/tutor_dev.sqlite3
# 本地身份 Mock：必须显式开启，且只在 TUTOR_ENV=local 时允许；开启后只接受回环地址的请求
TUTOR_LOCAL_IDENTITY_MOCK=false
# 启动时把 services/api/seed 下的自编工程样题写入空库
TUTOR_SEED_SAMPLE_CONTENT=false
# 间隔复测的间隔（分钟）。默认 T+1 / T+3 / T+7 天；本地演示可以改小
TUTOR_REVIEW_INTERVALS_MINUTES=1440,4320,10080
# 学情统计的最小样本数，低于它显示"信息不足"
TUTOR_PROGRESS_MIN_SAMPLES=5
# 草稿同步请求体上限（字节）
TUTOR_MAX_DRAFT_BYTES=2000000
# 学生去标识化用的 HMAC 密钥；非 local 环境必填
TUTOR_PSEUDONYM_SECRET=

# ---- 模型网关 ----
TUTOR_MODEL_ROUTES_PATH=config/model_routes.example.yaml
# 总开关：不为 true 时任何外部供应商都不会被调用
TUTOR_ALLOW_EXTERNAL_MODEL_CALLS=false

# 以下端点、模型与密钥在真实接入前由负责人核验后填写（DECISIONS_PENDING Q-04A）
BAILIAN_BASE_URL=
BAILIAN_API_KEY=
BAILIAN_MODEL_VISION=
BAILIAN_MODEL_TUTOR=
BAILIAN_MODEL_LIGHT=
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_REASONING=
VOLCENGINE_ARK_BASE_URL=
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_MODEL_GENERAL=

# ---- infra/compose.yaml（开发用 MySQL / Redis / 对象存储）----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=tutor_dev
MYSQL_USER=tutor
MYSQL_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
