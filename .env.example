# 复制为 .env 后按需填写。本文件不包含任何密钥，也不要把密钥提交进仓库。

# ---- API 服务 ----
# local / dev / staging / prod
TUTOR_ENV=local
# 开发态默认用 SQLite 文件保存演示状态；接入 MySQL 时改为 mysql+pymysql://...
TUTOR_DATABASE_URL=sqlite:///var/tutor_dev.sqlite3
# 数据库工程保护值（非生产SLA）；MySQL读写为socket超时，不是SQL总时限。
TUTOR_DATABASE_CONNECT_TIMEOUT_SECONDS=5
TUTOR_DATABASE_READ_TIMEOUT_SECONDS=10
TUTOR_DATABASE_WRITE_TIMEOUT_SECONDS=10
TUTOR_DATABASE_POOL_TIMEOUT_SECONDS=10
TUTOR_DATABASE_LOCK_TIMEOUT_SECONDS=5
# SQLite仅提供busy锁等待；内存SQLite不用QueuePool，不适用pool timeout。
TUTOR_DATABASE_SQLITE_BUSY_TIMEOUT_SECONDS=10
# 本地身份 Mock：必须显式开启，且只在 TUTOR_ENV=local 时允许；开启后只接受回环地址的请求
TUTOR_LOCAL_IDENTITY_MOCK=false
# 启动时把 services/api/seed 下的自编工程样题写入空库
TUTOR_SEED_SAMPLE_CONTENT=false
# 间隔复测的间隔（分钟）。默认 T+1 / T+3 / T+7 天；本地演示可以改小
TUTOR_REVIEW_INTERVALS_MINUTES=1440,4320,10080
# 学情统计的最小样本数，低于它显示"信息不足"
TUTOR_PROGRESS_MIN_SAMPLES=5
# 草稿同步请求体上限（字节）
TUTOR_MAX_DRAFT_BYTES=2000000
# 通用HTTP资源门控默认关闭；非local开启时须显式注入有界Redis客户端适配器，见SEC-303文档
TUTOR_HTTP_LIMITS_ENABLED=false
TUTOR_HTTP_LIMIT_WINDOW_MODE=fixed
TUTOR_HTTP_LIMIT_WINDOW_SECONDS=60
TUTOR_HTTP_LIMIT_PER_PEER=120
TUTOR_HTTP_LIMIT_PER_ACTOR=120
TUTOR_HTTP_LIMIT_GLOBAL=1000
TUTOR_HTTP_ROUTE_REQUESTS={}
TUTOR_HTTP_MAX_INFLIGHT=16
TUTOR_HTTP_MAX_BODY_BYTES=25165824
TUTOR_HTTP_BODY_TIMEOUT_SECONDS=30
# 本地附件与学生手工拍题原型均默认关闭；拍题同时要求两项为true且env=local。
# 不做真实OCR，不连接外部对象存储；原图沿用首次上传临时期限。
TUTOR_MEDIA_LOCAL_ENABLED=false
TUTOR_SCAN_MOCK_ENABLED=false
TUTOR_MEDIA_ROOT=var/media
TUTOR_MEDIA_TEMPORARY_TTL_SECONDS=7200
# 学生去标识化用的 HMAC 密钥；非 local 环境必填
TUTOR_PSEUDONYM_SECRET=

# ---- 模型网关 ----
TUTOR_MODEL_ROUTES_PATH=config/model_routes.example.yaml
# 总开关：不为 true 时任何外部供应商都不会被调用
TUTOR_ALLOW_EXTERNAL_MODEL_CALLS=false
# 持久调用另需显式注入 SqlReceiptStore、稳定 PSEUDONYM_SECRET；受控环境先完成迁移014。
TUTOR_DURABLE_MODEL_INVOCATIONS_ENABLED=false
# Does not enable external calls. A persisted pause requires explicit incident review.
TUTOR_MODEL_COST_OVERRUN_POLICY=record_only

# 以下端点、模型与密钥在真实接入前由负责人核验后填写（DECISIONS_PENDING Q-04A）
BAILIAN_BASE_URL=
BAILIAN_API_KEY=
BAILIAN_MODEL_VISION=
BAILIAN_MODEL_TUTOR=
BAILIAN_MODEL_LIGHT=
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_REASONING=
VOLCENGINE_ARK_BASE_URL=
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_MODEL_GENERAL=

# ---- infra/compose.yaml（开发用 MySQL / Redis / 对象存储）----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=tutor_dev
MYSQL_USER=tutor
MYSQL_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
