{
  "version": 1,
  "description": "图解模板白名单（docs/06 §6 注册表 V1）。服务端只下发这里注册的 template_id，参数必须是有限数值且落在 min/max 内；客户端按同一份边界渲染滑块。新增模板需要同时改 contracts/tutor_event.schema.json 的 template_id 枚举。",
  "templates": {
    "quadratic_graph": {
      "title": "二次函数图像",
      "summary": "y = ax² + bx + c 的开口方向、对称轴、顶点与单调区间。",
      "static_fallback": "二次函数 y = ax² + bx + c 的对称轴是 x = -b/(2a)。a > 0 时开口向上，对称轴左侧递减、右侧递增；a < 0 时相反。",
      "params": [
        { "name": "a", "label": "二次项系数 a", "min": -5, "max": 5, "step": 0.1, "default": 1, "integer": false, "adjustable": true },
        { "name": "b", "label": "一次项系数 b", "min": -10, "max": 10, "step": 0.1, "default": 0, "integer": false, "adjustable": true },
        { "name": "c", "label": "常数项 c", "min": -10, "max": 10, "step": 0.1, "default": 0, "integer": false, "adjustable": true }
      ]
    },
    "rectangle_area": {
      "title": "和为定值的矩形面积",
      "summary": "两边之和固定时，拖动分配比例观察面积何时最大，对应基本不等式的取等条件。",
      "static_fallback": "两个正数的和固定为 S 时，积 xy ≤ (S/2)²，当且仅当 x = y = S/2 时取等号；对应的矩形是正方形。",
      "params": [
        { "name": "sum", "label": "两边之和 S", "min": 2, "max": 40, "step": 1, "default": 10, "integer": false, "adjustable": true },
        { "name": "split", "label": "x 占 S 的比例", "min": 0.05, "max": 0.95, "step": 0.01, "default": 0.3, "integer": false, "adjustable": true }
      ]
    },
    "number_line": {
      "title": "数轴上的区间",
      "summary": "在数轴上标出一个区间，区分端点的开闭与无穷方向。",
      "static_fallback": "实心点表示端点包含在区间内，空心点表示不包含；箭头表示向该方向无限延伸。",
      "params": [
        { "name": "min", "label": "数轴左端", "min": -20, "max": 20, "step": 1, "default": -5, "integer": false, "adjustable": false },
        { "name": "max", "label": "数轴右端", "min": -20, "max": 20, "step": 1, "default": 5, "integer": false, "adjustable": false },
        { "name": "left", "label": "区间左端点", "min": -20, "max": 20, "step": 0.5, "default": -1, "integer": false, "adjustable": true },
        { "name": "right", "label": "区间右端点", "min": -20, "max": 20, "step": 0.5, "default": 3, "integer": false, "adjustable": true },
        { "name": "left_closed", "label": "左端点闭", "min": 0, "max": 1, "step": 1, "default": 1, "integer": true, "adjustable": true },
        { "name": "right_closed", "label": "右端点闭", "min": 0, "max": 1, "step": 1, "default": 0, "integer": true, "adjustable": true },
        { "name": "left_unbounded", "label": "向左无限延伸", "min": 0, "max": 1, "step": 1, "default": 0, "integer": true, "adjustable": true },
        { "name": "right_unbounded", "label": "向右无限延伸", "min": 0, "max": 1, "step": 1, "default": 0, "integer": true, "adjustable": true }
      ]
    },
    "force_diagram": {
      "title": "斜面上物块的受力",
      "summary": "斜面上物块的重力、支持力、摩擦力，以及重力沿斜面和垂直斜面的分解。",
      "static_fallback": "把重力分解为沿斜面向下的 mg·sinθ 和垂直斜面的 mg·cosθ；支持力 N = mg·cosθ。当 mg·sinθ 不超过最大静摩擦力时物块静止，否则沿斜面加速下滑，a = g(sinθ − μcosθ)。",
      "params": [
        { "name": "angle_deg", "label": "倾角 θ（度）", "min": 0, "max": 60, "step": 1, "default": 30, "integer": false, "adjustable": true },
        { "name": "mass", "label": "质量 m（kg）", "min": 0.5, "max": 20, "step": 0.5, "default": 2, "integer": false, "adjustable": true },
        { "name": "mu", "label": "动摩擦因数 μ", "min": 0, "max": 1, "step": 0.05, "default": 0.2, "integer": false, "adjustable": true },
        { "name": "g", "label": "重力加速度 g（m/s²）", "min": 9.8, "max": 10, "step": 0.2, "default": 9.8, "integer": false, "adjustable": true }
      ]
    },
    "motion_chart": {
      "title": "匀变速直线运动的 v–t 图",
      "summary": "速度随时间的直线、斜率表示的加速度，以及图线与时间轴围成的面积表示的位移。",
      "static_fallback": "匀变速直线运动 v = v₀ + at，v–t 图是一条直线，斜率等于加速度；图线与时间轴围成的面积等于位移 x = v₀t + ½at²。",
      "params": [
        { "name": "v0", "label": "初速度 v₀（m/s）", "min": -20, "max": 20, "step": 0.5, "default": 0, "integer": false, "adjustable": true },
        { "name": "a", "label": "加速度 a（m/s²）", "min": -10, "max": 10, "step": 0.5, "default": 2, "integer": false, "adjustable": true },
        { "name": "t_max", "label": "时间 t（s）", "min": 1, "max": 20, "step": 1, "default": 5, "integer": false, "adjustable": true }
      ]
    },
    "chemical_flow": {
      "title": "化学计量的换算流程",
      "summary": "已知物质量 → 物质的量 → 按化学计量数之比换算 → 所求物质量。",
      "static_fallback": "先用 n = m / M 把已知物的质量换成物质的量，再按方程式中的化学计量数之比得到所求物的物质的量，最后用 m = n·M 换回质量。",
      "params": [
        { "name": "mass_a", "label": "已知物质量 m(A)（g）", "min": 0.1, "max": 500, "step": 0.1, "default": 10, "integer": false, "adjustable": true },
        { "name": "molar_mass_a", "label": "已知物摩尔质量 M(A)（g/mol）", "min": 1, "max": 400, "step": 0.5, "default": 100, "integer": false, "adjustable": true },
        { "name": "coef_a", "label": "已知物计量数", "min": 1, "max": 10, "step": 1, "default": 1, "integer": true, "adjustable": true },
        { "name": "coef_b", "label": "所求物计量数", "min": 1, "max": 10, "step": 1, "default": 1, "integer": true, "adjustable": true },
        { "name": "molar_mass_b", "label": "所求物摩尔质量 M(B)（g/mol）", "min": 1, "max": 400, "step": 0.5, "default": 44, "integer": false, "adjustable": true }
      ]
    },
    "chemical_process": {
      "title": "工艺流程结构示意",
      "summary": "只观察题目已给的处理、分离、支路与回流关系，不推断物质、反应或操作。",
      "static_fallback": "原料依次经过处理Ⅰ、分离、处理Ⅱ到达产物。支路与回流是否存在以题干文字为准；这只是通用流程骨架，不是反应机理或实验操作指南。",
      "params": [
        {
          "name": "focus",
          "label": "观察位置",
          "min": 0,
          "max": 4,
          "step": 1,
          "default": 0,
          "integer": true,
          "adjustable": true
        },
        {
          "name": "branch",
          "label": "题设有支路",
          "min": 0,
          "max": 1,
          "step": 1,
          "default": 0,
          "integer": true,
          "adjustable": false
        },
        {
          "name": "recycle",
          "label": "题设有回流",
          "min": 0,
          "max": 1,
          "step": 1,
          "default": 0,
          "integer": true,
          "adjustable": false
        }
      ]
    },
    "triangle_schematic": {
      "title": "三角形已知位置示意",
      "summary": "只定位题目已给的A、B、C和三边，不增加辅助线、长度、角度或证明结论。",
      "static_fallback": "A、B位于基线两端，C位于基线上方，三边连接A、B、C。示意图，非按比例；不能凭外观推断长度、角度或关系。具体条件以题干文字及原图为准。",
      "params": [
        {
          "name": "apex_x",
          "label": "C点相对横向位置",
          "min": 0.2,
          "max": 0.8,
          "step": 0.05,
          "default": 0.35,
          "integer": false,
          "adjustable": false
        },
        {
          "name": "height",
          "label": "C点相对绘图高度",
          "min": 0.3,
          "max": 0.9,
          "step": 0.05,
          "default": 0.65,
          "integer": false,
          "adjustable": false
        },
        {
          "name": "focus",
          "label": "观察顶点",
          "min": 0,
          "max": 3,
          "step": 1,
          "default": 0,
          "integer": true,
          "adjustable": true
        }
      ]
    },
    "circle_schematic": {
      "title": "圆与已知点的位置示意",
      "summary": "只定位已给的圆O和圆上两点A、B，不增加连线、辅助点或证明结论。",
      "static_fallback": "O是圆心，A、B是圆上不同的两点。示意图，非按比例；不能凭外观推断长度、角度或关系。具体条件以题干文字及原图为准。",
      "params": [
        {"name": "a_position", "label": "A点相对绘图位置", "min": 0.05, "max": 0.2, "step": 0.01, "default": 0.1, "integer": false, "adjustable": false},
        {"name": "b_position", "label": "B点相对绘图位置", "min": 0.3, "max": 0.45, "step": 0.01, "default": 0.37, "integer": false, "adjustable": false},
        {"name": "focus", "label": "观察已知点", "min": 0, "max": 3, "step": 1, "default": 0, "integer": true, "adjustable": true}
      ]
    }
  }
}
