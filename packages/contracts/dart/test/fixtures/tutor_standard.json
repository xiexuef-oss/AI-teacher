        "state_after": "STANDARD",
        "payload": {
          "title": "常规解法",
          "steps": [
            {
              "text": "配方：$f(x)=x^2-2x-3=(x-1)^2-4$。"
            },
            {
              "text": "二次项系数 $a=1>0$，图像开口向上，对称轴为直线 $x=1$。"
            },
            {
              "text": "开口向上时，对称轴左侧函数递减、右侧函数递增，所以单调递增区间是 $[1,+\\infty)$。"
            }
          ],
          "final_answer": "B",
          "option_analysis": [
            {
              "key": "A",
              "verdict": "wrong",
              "text": "这是对称轴左侧的区间。开口向上时，左侧函数值随 $x$ 增大而减小，是递减区间。"
            },
            {
              "key": "B",
              "verdict": "correct",
              "text": "对称轴为 $x=1$，开口向上，对称轴右侧函数值随 $x$ 增大而增大。"
            },
            {
              "key": "C",
              "verdict": "wrong",
              "text": "对称轴算成了 $x=-1$。由 $x=-\\dfrac{b}{2a}$，这里 $b=-2$，注意符号；另外这个区间在对称轴左侧。"
            },
            {
              "key": "D",
              "verdict": "wrong",
              "text": "对称轴算成了 $x=-1$。由 $x=-\\dfrac{b}{2a}$，这里 $b=-2$，代入时注意符号。"
            }
          ],
          "key_points": [
            "配方或用 $x=-\\dfrac{b}{2a}$ 求对称轴",
            "开口方向决定哪一侧递增"
          ]
        },
