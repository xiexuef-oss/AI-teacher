    "content": {
      "stem": "函数 $f(x)=x^2-2x-3$ 的单调递增区间是（　）",
      "options": [
        {
          "key": "A",
          "text": "$(-\\infty,1]$"
        },
        {
          "key": "B",
          "text": "$[1,+\\infty)$"
        },
        {
          "key": "C",
          "text": "$(-\\infty,-1]$"
        },
        {
          "key": "D",
          "text": "$[-1,+\\infty)$"
        }
      ],
      "blanks": [],
