        "state_after": "FAST",
        "payload": {
          "title": "快速解法",
          "conditions": [
            "函数是二次函数 $y=ax^2+bx+c$（$a\\ne 0$）",
            "定义域是全体实数，没有被限制在某个区间内"
          ],
          "steps": [
            {
              "text": "对称轴 $x=-\\dfrac{b}{2a}=-\\dfrac{-2}{2\\times 1}=1$。"
            },
            {
              "text": "$a>0$ 时对称轴右侧递增，直接得 $[1,+\\infty)$。"
            }
          ],
          "final_answer": "B",
          "boundary": "如果定义域被限制（例如只在 $[0,3]$ 上讨论），递增区间要与定义域取交集；$a<0$ 时结论相反，对称轴左侧才是递增区间。",
          "reviewed": true
        },
